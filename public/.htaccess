<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Si el archivo o directorio existe físicamente (ej. assets/js/app.js), servirlo directamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # De lo contrario, enviar al Front Controller index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>
